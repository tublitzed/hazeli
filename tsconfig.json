{
  "compilerOptions": {
    "sourceMap": true,
    "outDir": "dist",
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "downlevelIteration": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "baseUrl": ".",
    "rootDir": "./server",
    "paths": {
      "server/*": ["./server/*"]
    }
  },

  "include": ["next-env.d.ts", "server/**/*"],
  "exclude": ["node_modules"]
}
